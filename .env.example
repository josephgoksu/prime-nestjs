# POSTGRES_HOST
# For MAC 0.0.0.0
# For WIN localhost
# For Docker "database"
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=postgres
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_SIZE=10
# Apply pending migrations when the app starts (Docker Compose sets this to true)
DB_RUN_MIGRATIONS=false
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<your-rsa-private-key-here>\n-----END RSA PRIVATE KEY-----\n"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your-rsa-public-key-here>\n-----END PUBLIC KEY-----\n"
NODE_ENV="development"
# Access token lifetime: a number with a unit (15m, 1h, 7d). A bare number is rejected.
# Keep it short: clients renew it with POST /auth/refresh.
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (1-365)
REFRESH_TOKEN_TTL_DAYS=30
# Rate limiting: requests per THROTTLE_TTL_MS window, per client IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
# Set when running behind a proxy or load balancer: a hop count (1) or the proxy subnets.
# Avoid "true": it trusts any client-sent X-Forwarded-For, so clients can pick their own IP
# and get around the rate limits.
TRUST_PROXY=false
# Logging: trace, debug, info, warn, error, fatal or silent (default: info in production, debug otherwise)
LOG_LEVEL=
# OpenTelemetry tracing, off unless an OTLP/HTTP endpoint is set (Collector, Jaeger, Tempo, Honeycomb...)
OTEL_SERVICE_NAME=prime-nestjs
OTEL_EXPORTER_OTLP_ENDPOINT=
# Traces-only endpoint, used instead of OTEL_EXPORTER_OTLP_ENDPOINT for traces when set
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# true turns tracing off even when an endpoint is set
OTEL_SDK_DISABLED=false
